---
// Importamos la configuración central de la empresa con los datos de contacto y ubicación
import { siteConfig } from '../data/site';

// Formateamos las áreas de servicio de forma legible para el listado final
const formattedServiceAreas = new Intl.ListFormat('en', {
  style: 'long',
  type: 'conjunction',
}).format(siteConfig.serviceAreas);

const currentYear = new Date().getFullYear();
---

<!-- Footer principal con HTML semántico -->
<footer class="bg-slate-900 text-slate-300 pt-16 pb-12 border-t border-slate-800">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8 max-w-7xl">
    
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12 mb-12">
      
      <!-- Columna 1: Información de la empresa y licencia -->
      <div class="flex flex-col items-start">
        <span class="text-xl font-extrabold text-white mb-4">
          {siteConfig.companyName}
        </span>
        <!-- Texto limpio alineado a los servicios reales de la empresa -->
        <p class="text-sm text-slate-300 leading-relaxed mb-4">
          Roofing installation, replacement, repair, and gutter services for homeowners in {siteConfig.city}, {siteConfig.state} and surrounding communities.
        </p>
        {siteConfig.licenseNumber && (
          <p class="text-xs text-slate-300 font-medium bg-slate-800 px-3 py-1.5 rounded-lg border border-slate-700">
            Contractor License #{siteConfig.licenseNumber}
          </p>
        )}
      </div>

      <!-- Columna 2: Enlaces rápidos de navegación -->
      <div>
        <h3 class="text-white font-bold text-base mb-4 tracking-wide uppercase">Quick Links</h3>
        <ul class="space-y-3 text-sm">
          <li>
            <a href="#services" class="hover:text-white transition-colors duration-200">Our Services</a>
          </li>
          <li>
            <a href="#why-us" class="hover:text-white transition-colors duration-200">Why Choose Us</a>
          </li>
          <li>
            <a href="#gallery" class="hover:text-white transition-colors duration-200">Recent Work</a>
          </li>
          <li>
            <a href="#quote" class="hover:text-white transition-colors duration-200">Free Estimate</a>
          </li>
        </ul>
      </div>

      <!-- Columna 3: Áreas de servicio con texto visible text-slate-300 -->
      <div>
        <h3 class="text-white font-bold text-base mb-4 tracking-wide uppercase">Service Areas</h3>
        <p class="text-sm text-slate-300 leading-relaxed">
          Serving homeowners in {formattedServiceAreas}.
        </p>
      </div>

      <!-- Columna 4: Contacto directo con ícono visible -->
      <div>
        <h3 class="text-white font-bold text-base mb-4 tracking-wide uppercase">Contact Us</h3>
        <ul class="space-y-3 text-sm">
          <li>
            <!-- Ícono con fill-slate-200/text-slate-200 para alto contraste sobre fondo oscuro -->
            <a
              href={`tel:${siteConfig.phoneForLink}`}
              class="inline-flex items-center gap-2 text-white font-bold hover:text-accent transition-colors duration-200"
            >
              <svg class="w-5 h-5 fill-slate-200" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"/>
              </svg>
              <span>{siteConfig.phoneDisplay}</span>
            </a>
          </li>
          <li class="text-slate-300">
            {siteConfig.streetAddress}, {siteConfig.city}, {siteConfig.state} {siteConfig.postalCode}
          </li>
          {siteConfig.email && (
            <li>
              <a href={`mailto:${siteConfig.email}`} class="text-slate-300 hover:text-white transition-colors duration-200">
                {siteConfig.email}
              </a>
            </li>
          )}
        </ul>
      </div>

    </div>

    <!-- Barra inferior de copyright usando {siteConfig.companyName} dinámico -->
    <div class="pt-8 border-t border-slate-800 flex flex-col sm:flex-row items-center justify-between text-xs text-slate-400 gap-4">
      <p>&copy; {currentYear} {siteConfig.companyName}. All rights reserved.</p>
    </div>

  </div>
</footer>