---
// Importamos la configuración central de la empresa con los datos de ubicación y contacto
import { siteConfig } from '../data/site';
---

<!-- Sección de Cierre / Formulario de Cotización con HTML semántico -->
<section id="quote" class="py-16 md:py-24 bg-surface text-slate-800 border-t border-slate-200">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8 max-w-7xl">
    
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      
      <!-- Columna de información persuasiva y contacto telefónico -->
      <div class="lg:col-span-5 flex flex-col items-start text-left">
        <span class="text-primary font-bold text-xs sm:text-sm tracking-wider uppercase bg-primary/10 px-3 py-1 rounded-full mb-3 inline-block">
          Get Started Today
        </span>
        
        <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight mb-4">
          Request Your Free, No-Obligation Roof Estimate
        </h2>
        
        <p class="text-slate-600 text-base sm:text-lg leading-relaxed mb-8">
          Protect your home with trusted local professionals in {siteConfig.city}, {siteConfig.state}. Fill out the form or call us directly to schedule your inspection.
        </p>

        <!-- Tarjeta de contacto telefónico directo -->
        <div class="w-full bg-white p-6 rounded-2xl border border-slate-200 shadow-sm flex items-center gap-4">
          <div class="w-12 h-12 rounded-xl bg-primary/10 text-primary flex items-center justify-center flex-shrink-0">
            <svg class="w-6 h-6 fill-current" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"/>
            </svg>
          </div>
          <div>
            <p class="text-xs text-slate-500 font-semibold uppercase tracking-wider">Prefer to talk right now?</p>
            <a href={`tel:${siteConfig.phoneForLink}`} class="text-lg sm:text-xl font-extrabold text-slate-900 hover:text-primary transition-colors duration-200">
              {siteConfig.phoneDisplay}
            </a>
          </div>
        </div>

      </div>

      <!-- Columna del Formulario optimizado mobile-first -->
      <div class="lg:col-span-7">
        <div class="bg-white rounded-2xl p-6 sm:p-10 border border-slate-200 shadow-xl">
          
          <form class="space-y-6" method="POST" action="/api/submit-quote">
            
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
              <!-- Nombre completo -->
              <div>
                <label for="fullName" class="block text-sm font-semibold text-slate-700 mb-2">Full Name</label>
                <input
                  type="text"
                  id="fullName"
                  name="fullName"
                  required
                  placeholder="John Doe"
                  class="w-full px-4 py-3 rounded-lg border border-slate-300 text-slate-900 focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent text-base"
                />
              </div>

              <!-- Teléfono -->
              <div>
                <label for="phone" class="block text-sm font-semibold text-slate-700 mb-2">Phone Number</label>
                <input
                  type="tel"
                  id="phone"
                  name="phone"
                  required
                  placeholder="(555) 000-0000"
                  class="w-full px-4 py-3 rounded-lg border border-slate-300 text-slate-900 focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent text-base"
                />
              </div>
            </div>

            <!-- Correo electrónico -->
            <div>
              <label for="email" class="block text-sm font-semibold text-slate-700 mb-2">Email Address</label>
              <input
                type="email"
                id="email"
                name="email"
                required
                placeholder="john@example.com"
                class="w-full px-4 py-3 rounded-lg border border-slate-300 text-slate-900 focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent text-base"
              />
            </div>

            <!-- Servicio de interés -->
            <div>
              <label for="serviceType" class="block text-sm font-semibold text-slate-700 mb-2">Service Needed</label>
              <select
                id="serviceType"
                name="serviceType"
                class="w-full px-4 py-3 rounded-lg border border-slate-300 text-slate-900 bg-white focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent text-base"
              >
                <option value="replacement">Roof Replacement</option>
                <option value="repair">Roof Repair / Storm Damage</option>
                <option value="inspection">Roof Inspection</option>
                <option value="other">Other Services</option>
              </select>
            </div>

            <!-- Mensaje o detalles adicionales -->
            <div>
              <label for="message" class="block text-sm font-semibold text-slate-700 mb-2">Project Details (Optional)</label>
              <textarea
                id="message"
                name="message"
                rows="4"
                placeholder="Tell us a bit about your roofing needs..."
                class="w-full px-4 py-3 rounded-lg border border-slate-300 text-slate-900 focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent text-base resize-none"
              ></textarea>
            </div>

            <!-- Botón de envío optimizado para pulgar en móviles -->
            <button
              type="submit"
              class="w-full py-4 rounded-lg bg-primary text-white font-bold text-lg shadow-lg hover:bg-primary/90 transition-colors duration-200 focus:outline-none focus:ring-4 focus:ring-primary/40 cursor-pointer"
            >
              Get My Free Quote
            </button>

            <p class="text-xs text-slate-500 text-center mt-4">
              By submitting this form, you agree to receive calls or text messages regarding your quote request. No spam, guaranteed.
            </p>

          </form>

        </div>
      </div>

    </div>

  </div>
</section>