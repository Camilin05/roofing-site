---
// Importamos los datos centrales de la empresa (ciudad, teléfono y servicios)
import { siteConfig } from '../data/site';

// Dirección de Formspree que recibe los datos del formulario
const formspreeEndpointUrl = 'https://formspree.io/f/mzerpgvk';
---

<!-- Sección de cierre con formulario de cotización -->
<section id="freeEstimates" class="py-16 md:py-24 bg-surface text-slate-800 border-t border-slate-200">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8 max-w-7xl">

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">

      <!-- Columna de información y contacto telefónico -->
      <div class="lg:col-span-5 flex flex-col items-start text-left">
        <span class="text-primary font-bold text-xs sm:text-sm tracking-wider uppercase bg-primary/10 px-3 py-1 rounded-full mb-3 inline-block">
          Get Started Today
        </span>

        <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight mb-4">
          Request Your Free Roof Estimate
        </h2>

        <p class="text-slate-600 text-base sm:text-lg leading-relaxed mb-8">
          Local roofing professionals in {siteConfig.city}, {siteConfig.state}. Fill out the form or call us directly to schedule your free estimate.
        </p>

        <!-- Tarjeta de contacto telefónico directo -->
        <div class="w-full bg-white p-6 rounded-2xl border border-slate-200 shadow-sm flex items-center gap-4">
          <div class="w-12 h-12 rounded-xl bg-primary/10 text-primary flex items-center justify-center flex-shrink-0">
            <svg class="w-6 h-6 fill-current" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"/>
            </svg>
          </div>
          <div>
            <p class="text-xs text-slate-500 font-semibold uppercase tracking-wider">Prefer to talk right now?</p>
            <a href={`tel:${siteConfig.phoneForLink}`} class="text-lg sm:text-xl font-extrabold text-slate-900 hover:text-primary transition-colors duration-200">
              {siteConfig.phoneDisplay}
            </a>
          </div>
        </div>

      </div>

      <!-- Columna del formulario -->
      <div class="lg:col-span-7">
        <div class="bg-white rounded-2xl p-6 sm:p-10 border border-slate-200 shadow-xl">

          <form id="quoteForm" class="space-y-6" method="POST" action={formspreeEndpointUrl}>

            <!-- Asunto fijo que verás en el correo que llega -->
            <input type="hidden" name="_subject" value={`New estimate request - ${siteConfig.companyName}`} />

            <!-- Trampa anti-spam: las personas no la ven, los bots sí la llenan -->
            <input type="text" name="_gotcha" class="hidden" tabindex="-1" autocomplete="off" aria-hidden="true" />

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
              <!-- Nombre -->
              <div>
                <label for="name" class="block text-sm font-semibold text-slate-700 mb-2">Full Name</label>
                <input
                  type="text"
                  id="name"
                  name="name"
                  required
                  autocomplete="name"
                  placeholder="John Doe"
                  class="w-full px-4 py-3 rounded-lg border border-slate-300 text-slate-900 focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent text-base"
                />
              </div>

              <!-- Teléfono -->
              <div>
                <label for="phone" class="block text-sm font-semibold text-slate-700 mb-2">Phone Number</label>
                <input
                  type="tel"
                  id="phone"
                  name="phone"
                  required
                  autocomplete="tel"
                  placeholder="(555) 000-0000"
                  class="w-full px-4 py-3 rounded-lg border border-slate-300 text-slate-900 focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent text-base"
                />
              </div>
            </div>

            <!-- Dirección de la propiedad -->
            <div>
              <label for="address" class="block text-sm font-semibold text-slate-700 mb-2">Property Address</label>
              <input
                type="text"
                id="address"
                name="address"
                required
                autocomplete="street-address"
                placeholder="123 Main St, Stockton, CA"
                class="w-full px-4 py-3 rounded-lg border border-slate-300 text-slate-900 focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent text-base"
              />
            </div>

            <!-- Servicio de interés: las opciones salen de siteConfig.services -->
            <div>
              <label for="service" class="block text-sm font-semibold text-slate-700 mb-2">Service Needed</label>
              <select
                id="service"
                name="service"
                required
                class="w-full px-4 py-3 rounded-lg border border-slate-300 text-slate-900 bg-white focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent text-base"
              >
                <option value="" disabled selected>Select a service</option>
                {siteConfig.services.map((service) => (
                  <option value={service.title}>{service.title}</option>
                ))}
                <option value="Other">Other</option>
              </select>
            </div>

            <!-- Aviso de error: oculto hasta que falle el envío -->
            <p id="quoteErrorMessage" class="hidden text-sm text-red-600 text-center" role="alert">
              Something went wrong. Please try again or call us at {siteConfig.phoneDisplay}.
            </p>

            <!-- Botón de envío -->
            <button
              id="quoteSubmitButton"
              type="submit"
              class="w-full py-4 rounded-lg bg-primary text-white font-bold text-lg shadow-lg hover:bg-primary/90 transition-colors duration-200 focus:outline-none focus:ring-4 focus:ring-primary/40 cursor-pointer disabled:opacity-60 disabled:cursor-not-allowed"
            >
              Get My Free Estimate
            </button>

            <p class="text-xs text-slate-500 text-center mt-4">
              By submitting this form, you agree to receive calls or text messages regarding your estimate request.
            </p>

          </form>

          <!-- Mensaje de éxito: aparece cuando Formspree confirma el envío -->
          <div id="quoteSuccessMessage" class="hidden text-center py-8" role="status">
            <div class="mx-auto mb-4 flex h-16 w-16 items-center justify-center rounded-full bg-green-100 text-3xl" aria-hidden="true">✅</div>
            <h3 class="text-2xl font-extrabold text-slate-900">Request sent!</h3>
            <p class="mt-2 text-slate-600">
              Thank you. We received your estimate request and will contact you soon.
            </p>
            <button
              id="quoteSendAnotherButton"
              type="button"
              class="mt-6 rounded-lg border border-slate-300 px-5 py-3 font-semibold text-slate-700 hover:bg-slate-50 cursor-pointer"
            >
              Send another request
            </button>
          </div>

        </div>
      </div>

    </div>

  </div>
</section>

<script>
  const quoteForm = document.querySelector<HTMLFormElement>('#quoteForm')
  const quoteSuccessMessage = document.querySelector<HTMLElement>('#quoteSuccessMessage')
  const quoteErrorMessage = document.querySelector<HTMLElement>('#quoteErrorMessage')
  const quoteSubmitButton = document.querySelector<HTMLButtonElement>('#quoteSubmitButton')
  const quoteSendAnotherButton = document.querySelector<HTMLButtonElement>('#quoteSendAnotherButton')

  if (quoteForm && quoteSuccessMessage && quoteErrorMessage && quoteSubmitButton && quoteSendAnotherButton) {
    quoteForm.addEventListener('submit', async (submitEvent) => {
      // Evita que el navegador navegue a la página de Formspree
      submitEvent.preventDefault()

      quoteErrorMessage.classList.add('hidden')
      quoteSubmitButton.disabled = true
      quoteSubmitButton.textContent = 'Sending...'

      try {
        const formspreeResponse = await fetch(quoteForm.action, {
          method: 'POST',
          body: new FormData(quoteForm),
          headers: { Accept: 'application/json' },
        })

        if (formspreeResponse.ok) {
          quoteForm.reset()
          quoteForm.classList.add('hidden')
          quoteSuccessMessage.classList.remove('hidden')
          quoteSuccessMessage.scrollIntoView({ behavior: 'smooth', block: 'center' })
        } else {
          quoteErrorMessage.classList.remove('hidden')
        }
      } catch (error) {
        // Sin internet o error de red
        quoteErrorMessage.classList.remove('hidden')
      } finally {
        quoteSubmitButton.disabled = false
        quoteSubmitButton.textContent = 'Get My Free Estimate'
      }
    })

    // El botón "Send another request" vuelve a mostrar el formulario vacío
    quoteSendAnotherButton.addEventListener('click', () => {
      quoteSuccessMessage.classList.add('hidden')
      quoteForm.classList.remove('hidden')
    })
  }
</script>