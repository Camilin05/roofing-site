---
import { siteConfig } from '../data/site'

// Convierte ["Lodi", "Modesto", "Sacramento", "Brentwood"] en
// "Lodi, Modesto, Sacramento, and Brentwood"
const serviceAreasText = new Intl.ListFormat('en', {
  style: 'long',
  type: 'conjunction',
}).format(siteConfig.serviceAreas)

const whyChooseUsPillars = [
  {
    icon: '🛡️',
    title: 'Licensed Contractor',
    description: `California contractor license #${siteConfig.licenseNumber}.`,
  },
  {
    icon: '📋',
    title: 'Free Estimates',
    description: 'Tell us what your roof needs and request a free estimate.',
  },
  {
    icon: '📍',
    title: 'Local Roofers',
    description: `Based in ${siteConfig.city}, ${siteConfig.state} and serving ${serviceAreasText}.`,
  },
  {
    icon: '🏠',
    title: 'Full Roofing Services',
    description: 'New roofing, replacements, repairs, leaks, maintenance and gutters.',
  },
]
---

<section id="why-us" class="bg-primary py-16 sm:py-20">
  <div class="mx-auto max-w-6xl px-4">
    <h2 class="text-center text-3xl font-extrabold text-white sm:text-4xl">
      Why Choose {siteConfig.companyName}
    </h2>

    <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {whyChooseUsPillars.map((pillar) => (
        <div class="rounded-xl bg-white/10 p-6 text-center">
          <span class="text-4xl" aria-hidden="true">{pillar.icon}</span>
          <h3 class="mt-4 text-lg font-bold text-white">{pillar.title}</h3>
          <p class="mt-2 text-sm text-slate-200">{pillar.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>