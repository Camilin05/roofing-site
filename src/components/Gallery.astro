---
import { siteConfig } from '../data/site'
---

<section id="gallery" class="bg-slate-50 py-16 sm:py-20">
  <div class="mx-auto max-w-6xl px-4">
    <h2 class="text-center text-3xl font-extrabold text-slate-900 sm:text-4xl">
      Our Recent Work
    </h2>
    <p class="mt-3 text-center text-slate-600">
      Drag the slider to compare before and after.
    </p>

    <div class="mt-10 grid gap-12 md:grid-cols-2 md:gap-8">
      {siteConfig.galleryJobs.map((job) => (
        <div
          data-before-after
          class="relative aspect-[4/3] overflow-hidden rounded-xl shadow-lg"
        >
          <!-- Foto de abajo: el DESPUÉS -->
          <img
            src={`/images/gallery/${job.jobId}-after.jpeg`}
            data-fallback={`/images/gallery/${job.jobId}-after.jpg`}
            alt={`After: ${job.altText}`}
            loading="lazy"
            class="absolute inset-0 h-full w-full object-cover"
            onerror="if(this.src.endsWith('.jpeg')){this.src=this.dataset.fallback;}"
          />

          <!-- Foto de arriba: el ANTES -->
          <img
            data-before-image
            src={`/images/gallery/${job.jobId}-before.jpeg`}
            data-fallback={`/images/gallery/${job.jobId}-before.jpg`}
            alt={`Before: ${job.altText}`}
            loading="lazy"
            class="absolute inset-0 h-full w-full object-cover"
            style="clip-path: inset(0 50% 0 0);"
            onerror="if(this.src.endsWith('.jpeg')){this.src=this.dataset.fallback;}"
          />

          <span class="absolute left-3 top-3 rounded bg-black/60 px-2 py-1 text-xs font-bold text-white">
            BEFORE
          </span>
          <span class="absolute right-3 top-3 rounded bg-black/60 px-2 py-1 text-xs font-bold text-white">
            AFTER
          </span>

          <div
            data-divider
            class="pointer-events-none absolute inset-y-0 w-1 -translate-x-1/2 bg-white shadow"
            style="left: 50%;"
          ></div>

          <input
            data-slider
            type="range"
            min="0"
            max="100"
            value="50"
            aria-label={`Compare before and after: ${job.altText}`}
            class="absolute inset-0 h-full w-full cursor-ew-resize touch-pan-y opacity-0"
          />
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  const comparisonContainers = document.querySelectorAll<HTMLElement>('[data-before-after]')

  comparisonContainers.forEach((comparisonContainer) => {
    const sliderInput = comparisonContainer.querySelector<HTMLInputElement>('[data-slider]')
    const beforeImage = comparisonContainer.querySelector<HTMLElement>('[data-before-image]')
    const dividerLine = comparisonContainer.querySelector<HTMLElement>('[data-divider]')

    if (!sliderInput || !beforeImage || !dividerLine) return

    sliderInput.addEventListener('input', () => {
      const sliderPercentage = Number(sliderInput.value)
      beforeImage.style.clipPath = `inset(0 ${100 - sliderPercentage}% 0 0)`
      dividerLine.style.left = `${sliderPercentage}%`
    })
  })
</script>