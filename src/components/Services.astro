---
// Importamos la configuración central de la empresa con los datos de servicios y ubicación
import { siteConfig } from '../data/site';
---

<!-- Sección de Servicios con HTML semántico -->
<section id="services" class="py-16 md:py-24 bg-white text-slate-800">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8 max-w-7xl">
    
    <!-- Encabezado de la sección -->
    <div class="text-center max-w-3xl mx-auto mb-12 md:mb-16">
      <span class="text-primary font-bold text-xs sm:text-sm tracking-wider uppercase bg-primary/10 px-3 py-1 rounded-full mb-3 inline-block">
        Our Services
      </span>
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-extrabold text-slate-900 tracking-tight mt-2 mb-4">
        Roofing Services in {siteConfig.city}
      </h2>
      <p class="text-base sm:text-lg text-slate-600 leading-relaxed">
        New roofs, replacements, repairs, leaks, maintenance and gutters for homeowners in {siteConfig.city} and nearby cities.
      </p>
    </div>

    <!-- Cuadrícula de servicios con contraste visible e intercalado marcado -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {siteConfig.services.map((service, index) => (
        <article 
          class:list={[
            "rounded-2xl p-6 sm:p-8 border transition-all duration-300 flex flex-col justify-between group hover:shadow-xl",
            // Alternamos entre blanco impecable y un azul slate claro con suficiente contraste
            index % 2 === 0 
              ? "bg-white border-slate-200 shadow-sm" 
              : "bg-slate-100/90 border-slate-300/80 shadow-inner"
          ]}
        >
          
          <div>
            <!-- Contenedor del ícono/emoji dinámico -->
            <div class="w-14 h-14 rounded-xl bg-primary/10 text-primary flex items-center justify-center text-3xl mb-6 group-hover:bg-primary transition-colors duration-300">
              <span aria-hidden="true">{service.icon}</span>
            </div>

            <!-- Título del servicio -->
            <h3 class="text-xl sm:text-2xl font-bold text-slate-900 mb-3 group-hover:text-primary transition-colors duration-200">
              {service.title}
            </h3>

            <!-- Descripción detallada del servicio -->
            <p class="text-slate-600 text-sm sm:text-base leading-relaxed mb-6">
              {service.description}
            </p>
          </div>

          <!-- Enlace de acción rápido para cada servicio -->
          <div class="pt-4 border-t border-slate-200/80">
            <a
              href="#freeEstimates"
              class="inline-flex items-center gap-2 text-primary font-semibold text-sm hover:text-primary/80 transition-colors duration-200"
            >
              <span>Get a Free Estimate</span>
              <svg class="w-4 h-4 transform group-hover:translate-x-1 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
              </svg>
            </a>
          </div>

        </article>
      ))}
    </div>

  </div>
</section>